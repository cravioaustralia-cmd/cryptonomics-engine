# Copy this file to .env and fill in your values. Never commit .env.
# 1) Create a bot: talk to @BotFather in Telegram, send /newbot, copy the token.
TELEGRAM_BOT_TOKEN=123456789:replace-with-your-bot-token-from-BotFather
# 2) Your chat id: send any message to your bot, then open
#    https://api.telegram.org/bot<TOKEN>/getUpdates and copy "chat":{"id": ...}
#    Groups/channels have negative ids like -1001234567890.
TELEGRAM_CHAT_ID=123456789
